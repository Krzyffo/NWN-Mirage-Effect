// NWN-Mirage: desert heat haze and mirage over the final image.
//
// Replaces the stock fsfbpostpr (the full-screen post-processing pass).
// The stock pass runs unchanged first, so sharpen, depth of field,
// vibrance, gamma and so on still work; the mirage is added on top as the
// difference between a rippled and a plain sample of the scene.
//
// Off (no change at all) until a script sets scriptableFloat1 above 0,
// see src/nss/mirage_inc.nss:
//   scriptableFloat1  strength, 0..1
//   scriptableFloat2  distance in metres where the shimmer starts
//   scriptableFloat3  distance where it reaches full strength; the
//                     mirage "water" lies beyond this
//   scriptableFloat4  mirage water (sky reflected below the horizon), 0..1
//   scriptableFloat5  blur of the hot, distant air, 0..1
//   scriptableInt1    1 = debug view: red = shimmer, blue = mirage water

#define SHADER_TYPE 2

#include "inc_postpr"
#include "inc_scriptable"

#define MIRAGE_PIXELS     3.0     // largest ripple, in pixels at 1080p
#define MIRAGE_BLUR_PIXELS 3.0    // blur radius at full strength, in pixels at 1080p
#define MIRAGE_BAND_DEG   6.0     // the water band reaches this far below the horizon
#define MIRAGE_CLEAR_PIXELS 32.0  // the water mirrors nothing this close to a near object, in pixels at 1080p
#define MIRAGE_TWO_PI     6.2831853
#define MIRAGE_PERIOD_MS  100000  // time wraps every 100 s; the waves below repeat in it

// Rising heat: horizontal ripples drifting upward, two layers. Frequencies
// are whole multiples of 2*pi/100 s, so the wrap of the clock is seamless.
vec2 MirageRipple(vec2 uv, float t)
{
    float w = MIRAGE_TWO_PI / 100.0;
    float y = uv.y * 1080.0;
    float a = sin(y * 0.11 - t * w * 64.0 + sin(uv.x * 9.0 + t * w * 16.0) * 1.5);
    float b = sin(y * 0.37 - t * w * 116.0 + uv.x * 23.0);
    return vec2(a * 0.7 + b * 0.3, (b - a) * 0.2);
}

float MirageIsSky(float fDepth)
{
    return step(farClip * 0.95, fDepth);
}

// Pixels at 1080p to texture coordinates, so the effect looks the same at
// any resolution.
vec2 MiragePixels(vec2 vPx)
{
    return vec2(vPx.x / fAspectRatio, vPx.y) / 1080.0;
}

// Offset of blur tap i (0..11) around the centre, in 1080p pixels: hot air
// smears sideways more than up and down. Returns the tap's weight in z.
vec3 MirageTap(int i, float fRadiusPx)
{
    float fAngle = float(i) * 0.5235988 + 0.2617994;   // 30 degrees apart
    float fRing = mod(float(i), 2.0) < 0.5 ? 1.0 : 0.5;
    return vec3(vec2(cos(fAngle), sin(fAngle) * 0.6) * fRing * fRadiusPx, 1.5 - fRing);  // inner ring counts more
}

// Soft, slightly wide blur of the scene around uvCenter. Taps that land on
// something nearer than fMinDepth are skipped, so close objects never bleed
// into the haze.
vec4 MirageBlur(vec2 uvCenter, float fRadiusPx, float fMinDepth)
{
    vec4 cSum = texture2D(texFBColor, uvCenter);
    if (fRadiusPx < 0.25) return cSum;
    float fWeights = 1.0;
    for (int i = 0; i < 12; i++)
    {
        vec3 vTap = MirageTap(i, fRadiusPx);
        vec2 uvTap = uvCenter + MiragePixels(vTap.xy);
        if (GetDepth(uvTap) >= fMinDepth)
        {
            cSum += texture2D(texFBColor, uvTap) * vTap.z;
            fWeights += vTap.z;
        }
    }
    return cSum / fWeights;
}

// How much a point at this depth may be mirrored: sky and ground well
// beyond fFar fully, anything nearer not at all, with a soft ramp between.
float MirageMirrorable(float fDepth, float fFar)
{
    return max(MirageIsSky(fDepth), smoothstep(fFar, fFar * 2.0, fDepth));
}

// Blur for the mirage water. Every tap, the centre too, is weighted by how
// far away it is, so the player, held weapons and anything else close never
// get a mirrored copy. fCoverage says how much of the blur was far content:
// 1 = all of it, 0 = none; the caller fades the water by it, so the mirror
// thins out smoothly next to near objects instead of cutting off.
vec4 MirageMirrorBlur(vec2 uvCenter, float fRadiusPx, float fFar, out float fCoverage)
{
    float fW = MirageMirrorable(GetDepth(uvCenter), fFar);
    vec4 cSum = texture2D(texFBColor, uvCenter) * fW;
    float fWeights = fW;
    float fTotal = 1.0;
    for (int i = 0; i < 12; i++)
    {
        vec3 vTap = MirageTap(i, fRadiusPx);
        vec2 uvTap = uvCenter + MiragePixels(vTap.xy);
        fW = MirageMirrorable(GetDepth(uvTap), fFar) * vTap.z;
        cSum += texture2D(texFBColor, uvTap) * fW;
        fWeights += fW;
        fTotal += vTap.z;
    }
    fCoverage = fWeights / fTotal;
    return fWeights > 0.001 ? cSum / fWeights : vec4(0.0);
}

// 0..1: how much something near the camera lies within MIRAGE_CLEAR_PIXELS
// of uvCenter, checked along a vertical and a horizontal line of taps 2 px
// apart, so even a 1 px spear shaft at any angle is found. Glow and fire
// effects on weapons write no depth; keeping clear of the weapon itself
// keeps them out of the mirror too.
float MirageNearAround(vec2 uvCenter, float fFar)
{
    float fNearest = 0.0;
    for (int i = 0; i < 33; i++)
    {
        float fPx = float(i - 16) * (MIRAGE_CLEAR_PIXELS / 16.0);
        fNearest = max(fNearest, 1.0 - MirageMirrorable(GetDepth(uvCenter + MiragePixels(vec2(0.0, fPx))), fFar));
        fNearest = max(fNearest, 1.0 - MirageMirrorable(GetDepth(uvCenter + MiragePixels(vec2(fPx, 0.0))), fFar));
    }
    return fNearest;
}

float MirageLum(vec4 c)
{
    return dot(c.rgb, vec3(0.299, 0.587, 0.114));
}

// Whether the far content at uvTap is clear of near objects just above and
// below it, 0..1.
float MirageClearColumn(vec2 uvTap, float fFar)
{
    float fW = 1.0;
    for (int k = 0; k < 5; k++)
        fW *= MirageMirrorable(GetDepth(uvTap + MiragePixels(vec2(0.0, float(k - 2) * 6.0))), fFar);
    return fW;
}

// The colour of the sky and far haze at height fY, from eight columns spread
// across the whole screen. Stands in for whatever a near object hides, and
// tells weapon glow and fire apart from the sky: those write no depth, so
// only their brightness gives them away. Columns much brighter than the rest
// count less, so a glow caught by one column does not tint the row. The
// result is the same across the row, so it never draws lines or shapes.
// fFound is how much clear sky was found, 0..1.
vec4 MirageRowSky(float fY, float fFar, out float fFound)
{
    float fLumSum = 0.0;
    float fClearSum = 0.0;
    for (int i = 0; i < 8; i++)
    {
        vec2 uvTap = vec2((float(i) + 0.5) / 8.0, fY);
        float fW = MirageClearColumn(uvTap, fFar);
        fLumSum += MirageLum(texture2D(texFBColor, uvTap)) * fW;
        fClearSum += fW;
    }
    fFound = clamp(fClearSum / 3.0, 0.0, 1.0);   // three clear columns are plenty
    if (fClearSum < 0.001) return vec4(0.0);
    float fLumAvg = fLumSum / fClearSum;

    vec4 cSum = vec4(0.0);
    float fWeights = 0.0;
    for (int i = 0; i < 8; i++)
    {
        vec2 uvTap = vec2((float(i) + 0.5) / 8.0, fY);
        vec4 c = texture2D(texFBColor, uvTap);
        float fW = MirageClearColumn(uvTap, fFar)
                 * (1.0 - 0.95 * smoothstep(1.05, 1.25, MirageLum(c) / max(fLumAvg, 0.001)));
        cSum += c * fW;
        fWeights += fW;
    }
    return fWeights > 0.001 ? cSum / fWeights : vec4(0.0);
}

void main()
{
    vec4 Color = FS_PostProcess();

    float fStrength = clamp(scriptableFloat1, 0.0, 1.0);
    if (fStrength <= 0.0)
    {
        gl_FragColor = Color;
        return;
    }

    float fNear = max(scriptableFloat2, 0.0);
    float fFar  = max(scriptableFloat3, fNear + 1.0);
    float fWater = clamp(scriptableFloat4, 0.0, 1.0);
    float fBlur = clamp(scriptableFloat5, 0.0, 1.0);

    vec2 uv = vVertexTexCoords;
    float t = float(worldtimerTimeOfDay - (worldtimerTimeOfDay / MIRAGE_PERIOD_MS) * MIRAGE_PERIOD_MS) / 1000.0;
    float fDepth = GetDepth(uv);
    float fSky = MirageIsSky(fDepth);

    // Where the horizon is: cameraPitch is 90 when looking level, less
    // when looking down. Elevation of this pixel above the horizon, radians.
    float fTilt = radians(90.0 - cameraPitch);
    float fPixelAngle = atan((uv.y * 2.0 - 1.0) * fNDCToView);
    float fElevation = fPixelAngle - fTilt;

    // Shimmer: grows with distance, strongest near the horizon (heat rises
    // off the ground, so the sky high up stays still).
    float fFade = fSky > 0.5 ? 1.0 : smoothstep(fNear, fFar, fDepth);
    float fBand = 1.0 - smoothstep(0.0, radians(25.0), abs(fElevation));
    float fShimmer = fStrength * fFade * fBand;

    vec2 vOffset = MiragePixels(MirageRipple(uv, t) * MIRAGE_PIXELS * fShimmer);
    vec2 uvRipple = uv + vOffset;
    // Never pull a nearer object's pixels into the haze behind it. Past
    // MIRAGE_NEAR that is anything much closer than this pixel; anything
    // beyond fFar is far enough to always mix with.
    float fMinDepth = max(fNear, min(fDepth * 0.5, fFar));
    if (GetDepth(uvRipple) < fMinDepth) uvRipple = uv;

    vec4 cPlain = texture2D(texFBColor, uv);
    float fBlurPx = MIRAGE_BLUR_PIXELS * fBlur * fShimmer;
    vec4 cMirage = MirageBlur(uvRipple, fBlurPx, fMinDepth);

    // Mirage water: far ground just below the horizon shows the sky above
    // it, mirrored and rippling, like a lake that is not there.
    float fBelow = -fElevation;
    float fPool = 0.0;
    if (fWater > 0.0 && fBelow > 0.0 && fSky < 0.5)
    {
        // This pixel looks fBelow under the horizon; its mirror image
        // looks as far above it, i.e. at view angle (fBelow + tilt).
        float fMirrorAngle = fBelow + fTilt;
        float fMirrorY = tan(fMirrorAngle) / fNDCToView * 0.5 + 0.5;
        vec2 uvMirror = vec2(uv.x, fMirrorY) + vOffset * 2.5;
        if (uvMirror.y < 1.0)
        {
            // Blurred more than the shimmer: the "water" is never sharp.
            // Only far content is mirrored; see MirageMirrorBlur.
            float fCoverage;
            vec4 cSkyMirror = MirageMirrorBlur(uvMirror, MIRAGE_BLUR_PIXELS * (0.5 + fBlur), fFar, fCoverage);
            fCoverage *= 1.0 - MirageNearAround(uvMirror, fFar);
            float fFound;
            vec4 cRowSky = MirageRowSky(uvMirror.y, fFar, fFound);
            // Weapon glow and fire are sky to the depth buffer; catch them
            // by being brighter than the sky at this height.
            float fGlow = smoothstep(1.08, 1.3, MirageLum(cSkyMirror) / max(MirageLum(cRowSky), 0.001));
            fCoverage *= 1.0 - fGlow * step(0.001, fFound);
            // Where something near or a glow hides the mirrored spot, show
            // the plain sky of this height instead; fade the water only
            // where no clear sky is found at all.
            cSkyMirror = mix(cRowSky, cSkyMirror, fCoverage);
            fCoverage = mix(fFound, 1.0, fCoverage);
            fPool = fWater * fStrength * fCoverage * fCoverage
                  * smoothstep(fNear, fFar, fDepth)
                  * (1.0 - smoothstep(0.0, radians(MIRAGE_BAND_DEG), fBelow));
            // The reflection is a little paler than the sky, like haze.
            cMirage = mix(cMirage, mix(cSkyMirror, vec4(1.0), 0.15), fPool);
        }
    }

    // Add only the change, run through the same tonemap as the stock pass.
    vec3 a = cMirage.rgb;
    vec3 b = cPlain.rgb;
    ApplyColorTonemap(a);
    ApplyColorTonemap(b);
    Color.rgb += a - b;

    if (scriptableInt1 == 1)
        Color.rgb = mix(Color.rgb, vec3(1.0, 0.0, 0.0), fShimmer * 0.6) + vec3(0.0, 0.0, fPool);

    gl_FragColor = Color;
}
